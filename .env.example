# Local development defaults only. Never put real credentials in this file.
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard
PORT=3000
VITE_API_BASE_URL=http://localhost:3000
# Optional deployment-controlled absolute module path providing trusted host authentication.
DASHBOARD_HOST_MODULE=
# Provider environment credentials are bound to this one installation.
DASHBOARD_INSTALLATION_ID=
# Optional Jira Cloud origin.
JIRA_BASE_URL=
# Optional provider credentials; production values belong in the host's
# protected secret store, never sent to the browser or persisted in PostgreSQL.
GITHUB_COPILOT_TOKEN=
GITHUB_ENTERPRISE_SLUG=
OPENAI_ADMIN_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
