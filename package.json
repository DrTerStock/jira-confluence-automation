{
  "name": "jira-confluence-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --project scripts/demo/tsconfig.json",
    "test": "vitest run",
    "format:check": "prettier --check README.md .github/workflows/node-ci.yml eslint.config.js vitest.config.ts tsconfig.base.json package.json backend/package.json backend/tsconfig.json \"backend/src/**/*.ts\" frontend/index.html frontend/package.json frontend/tsconfig.json frontend/vite.config.ts \"frontend/src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" shared/types/dashboard.d.ts docker-compose.yml scripts/demo/start.ts scripts/demo/tsconfig.json scripts/demo/walkthrough.js",
    "format": "prettier --write .",
    "dev:demo": "tsx scripts/demo/start.ts",
    "test:walkthrough": "node scripts/demo/walkthrough.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.0",
    "prettier": "^3.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitest": "^4.1.11"
  }
}
